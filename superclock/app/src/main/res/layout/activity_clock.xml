<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clickable="true"
    android:focusable="true">

    <org.dalwadi.superclock.clock.ClockFaceView
        android:id="@+id/clockFace"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Above the scrim the alarm line would outshine the dimmed digits it sits under.
         At the top, not the bottom: the voice overlay writes its transcript and its reply across
         the lower part of the face and the two collided. The margin keeps it off the very edge now
         that the window extends into the cutout region. -->
    <TextView
        android:id="@+id/alarmLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-light"
        android:letterSpacing="0.08"
        android:textSize="15sp"
        android:textColor="@color/digit_dim"
        android:visibility="gone" />

    <View
        android:id="@+id/dimScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />

    <org.dalwadi.superclock.ui.VoiceOverlayView
        android:id="@+id/voiceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
